include README.md
include LICENSE
include pyproject.toml
include setup.py
include requirements.txt
include pytest.ini
include Makefile

recursive-include hscredit *.py *.xlsx *.csv *.ttf py.typed
recursive-include hscredit/resources/datasets *.parquet *.md *.svg
recursive-include hscredit/resources/platform *.html *.js *.css *.json *.txt *.svg *.woff2 *.ttf
include hscredit/resources/platform/favicon.ico
include docs/_static/hengshucredit_logo.svg
include docs/assets/readme/wechat.svg
include docs/assets/readme/wechat-official-account.svg
recursive-include web *.json *.js *.vue *.css *.html *.txt *.woff2
include web/public/favicon.ico
prune web/node_modules
exclude hscredit/resources/datasets/hscredit.parquet
recursive-include docs *.md
recursive-include examples *.ipynb
recursive-include scripts *.py

# 私有演示数据与本地审计材料不进入发布包。
exclude examples/hscredit_yyp.xlsx
prune docs/audits
prune .audit_tmp

recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * ~$*
recursive-exclude * .ipynb_checkpoints
recursive-exclude * .pytest_cache
recursive-exclude * .mypy_cache
recursive-exclude examples tree_viz_output/*
recursive-exclude catboost_info *
recursive-exclude .idea *
recursive-exclude hscredit.egg-info *
recursive-exclude tests *
recursive-exclude build *
recursive-exclude dist *
