include README.md
include LICENSE
include pyproject.toml
include setup.py
include requirements.txt
include pytest.ini
include Makefile
include AGENTS.md

recursive-include hscredit *.py *.xlsx *.csv *.ttf
recursive-include docs *.md
recursive-include examples *.ipynb *.py

recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * ~$*
recursive-exclude * .ipynb_checkpoints
recursive-exclude * .pytest_cache
recursive-exclude * .mypy_cache
recursive-exclude examples tree_viz_output/*
recursive-exclude catboost_info *
recursive-exclude .idea *
recursive-exclude hscredit.egg-info *
recursive-exclude tests *
recursive-exclude build *
recursive-exclude dist *
